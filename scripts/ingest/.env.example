# Copy this file to scripts/ingest/.env and fill it in. .env is ignored by git.
# The service-role key can read and write everything in the database.
# NEVER put it in the frontend, in .env.local, or in a commit.
# Supabase dashboard -> Project Settings -> API -> "service_role" key.

SUPABASE_SERVICE_ROLE_KEY=

# Optional: the project URL. If empty, VITE_SUPABASE_URL from .env.local is used.
SUPABASE_URL=
