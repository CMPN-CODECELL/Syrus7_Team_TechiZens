# Copy this file to .env.local and fill in the values (ask your teammate).
# .env.local is ignored by git, so your keys never get uploaded.
# Only variables that start with VITE_ are available in the frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. true = "Sign in with Google" signs in as a demo student (no Google account), while the
# opportunities are still read from Supabase. Leave it off for the real Google login. See README.md.
# VITE_DEMO_LOGIN=true
